# docker-compose.oci.yml용 환경 변수 예시. 복사해서 .env로 쓰고 값을 바꾼다 (.env는 커밋 금지).
# ops/oci/bootstrap.sh는 .env가 없으면 무작위 값으로 새로 만든다.
POSTGRES_PASSWORD=change-me
WEBHOOK_SECRET=change-me
GRAFANA_ADMIN_PASSWORD=change-me
# 캠페인 종료 후 정산 유예 (기본 스택은 7d, 시연 배포는 0s)
SETTLEMENT_GRACE_PERIOD=0s
# 127.0.0.1로 바꾸면 app도 SSH 터널로만 접근된다.
APP_BIND=0.0.0.0
